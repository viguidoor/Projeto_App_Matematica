{
  "name": "operacao-area",
  "private": true,
  "version": "0.1.0",
  "description": "Operação Área: Reconstruindo Nossa Escola — protótipo da missão O Jardim Geométrico (Etapa 1, modo DEMONSTRAÇÃO)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "./infra/local/stack.sh up",
    "db:down": "./infra/local/stack.sh down",
    "db:reset": "node infra/local/migrate.mjs --reset",
    "test:supabase": "./infra/local/stack.sh limit 1000 && vitest run --config vitest.supabase.config.ts",
    "test:all": "vitest run && npm run test:supabase && npm run test:supabase:limite-padrao",
    "check:secrets": "node scripts/verificar-segredos.mjs",
    "test:supabase:limite-padrao": "./infra/local/stack.sh limit 30 && vitest run --config vitest.supabase.config.ts tests-supabase/join35.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
