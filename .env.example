# Variáveis do APLICATIVO (build). Copie para .env.local; ele é ignorado pelo git.
# Padrão: modo DEMONSTRAÇÃO, sem servidor e sem credenciais.
VITE_BACKEND=demo

# Modo CONECTADO (Supabase): use somente a chave PÚBLICA (anon/publishable). NUNCA a chave secreta/service_role.
# Local (Docker):  VITE_SUPABASE_URL=http://127.0.0.1:54321  e a ANON_KEY gerada em infra/local/.env
# VITE_BACKEND=supabase
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
